{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    // system_grant app permissions: declared only, no runtime dialog/ACL.
    // INTERNET: the slirp NAT backend opens host sockets for the emulated
    // NE2000 card, so the guest's outbound traffic needs it at process level.
    // FILE_ACCESS_PERSIST: fileShare.persistPermission/activatePermission of
    // picker-picked C: mount folders (normal level, system_grant). Store
    // builds additionally need this permission requested via AGC (受限权限
    // 申请, auto-approved) so the signing profile carries its ACL entry.
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      }
    ],
    "pages": "$profile:main_pages",
    // AGC standardized privacy hosting (debug/local-install path; store
    // builds take the hosted config from AGC). The system pops the
    // standardized privacy dialog itself — never self-draw one, AppGallery
    // review rejects hosted apps that do.
    "metadata": [
      {
        "name": "appgallery_privacy_hosted",
        "value": "1"
      },
      {
        "name": "appgallery_privacy_link_privacy_statement",
        "value": "https://agreement-drcn.hispace.dbankcloud.cn/index.html?lang=zh&agreementId=2032214202961163328"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        // No ability-level "icon" here on purpose: it would override the
        // app.json5 layered icon, and AGC review flags the flattened legacy
        // single-layer image (must be the 1024x1024 layered icon instead).
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon_startwindow",
        "startWindowBackground": "$color:start_window_background",
        // Sensor-following rotation gated by the control-center rotation
        // switch. Without this field a phone window stays in its launch
        // orientation and never rotates (tablets rotate by system policy
        // anyway) — that asymmetry is why phones could not get back to
        // landscape after the forced-landscape code was removed.
        "orientation": "auto_rotation_restricted",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}